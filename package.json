{
  "name": "tracewise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-first PCB schematic and layout tool, run locally: download from 4k7.dev or npx github:hoihu/4k7",
  "keywords": [
    "pcb",
    "schematic",
    "layout",
    "eda",
    "electronics",
    "gerber",
    "ai",
    "mcp"
  ],
  "license": "MIT",
  "author": "Martin Fischer",
  "homepage": "https://4k7.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoihu/4k7.git"
  },
  "bugs": "https://github.com/hoihu/4k7/issues",
  "bin": {
    "tracewise": "dist/tracewise.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "scripts/dev.sh",
    "dev:here": "scripts/dev.sh",
    "dev:web": "npm run dev -w @tracewise/web",
    "build": "npm run build -w @tracewise/web",
    "package": "npm run build && node scripts/package.mjs",
    "start": "npm run package && node dist/tracewise.js",
    "prepare": "npm run package",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run check:package",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run check -w @tracewise/web",
    "server": "node --watch tools/server/src/main.ts --serve"
  },
  "devDependencies": {
    "rolldown": "^1.2.11",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "pdfjs-dist": "^6.3.289",
    "ws": "^8.21.3"
  }
}
