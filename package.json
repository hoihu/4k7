{
  "name": "tracewise",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tracewise/web",
    "build": "npm run build -w @tracewise/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run check -w @tracewise/web",
    "bridge": "node tools/bridge/src/main.ts --serve"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
